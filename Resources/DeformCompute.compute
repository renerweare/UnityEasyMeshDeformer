// ============================================================================
// DeformCompute.compute —— 晶格变形（FFD，自由变形）GPU 内核
// ============================================================================
// 职责：对网格的每个顶点执行一次「自由变形」：
//   1. 用 ObjectToDeform 把顶点从对象空间变换到晶格局部空间；
//   2. 计算顶点所在的晶格单元（GetCell）与单元内归一化坐标（GetCellPosition）；
//   3. 按插值方式（线性清晰 / 线性平滑 / 三次方）对相邻控制点的偏移加权求和，
//      结果作为顶点的位移累加到原位置上；
//   4. 用 DeformToObject 把变形后的位置变换回对象空间写回顶点缓冲。
//
// 关键字（keyword）说明：
//   DEFORM_NORMALS            —— 同时变形法线与切线（通过两个微元点重建）
//   DEFORM_MULTIPLE_BUFFERS   —— 使用附加顶点缓冲（颜色/UV 等），否则附加缓冲复用主缓冲
//   DEFORM_INTRP_SMOOTH       —— 线性插值 + SmoothStep 平滑
//   DEFORM_INTRP_CUBIC        —— 三次方插值（否则为线性插值）
//   DEFORM_ZERO_OUTSIDE       —— 越界控制点偏移归零（对应晶格项的 Global=false）
//   DEFORM_MASK_CONSTANT/COLOR/UV/TEXTURE —— 顶点遮罩类型（无遮罩时不定义 DEFORM_MASK）
//   DEFORM_USE_INDICES        —— 仅对指定材质（submesh）的顶点变形
// ============================================================================

#pragma kernel Deform

// 声明所有多编译关键字组合（local 表示仅对本着色器生效，__ 表示第一个组合为「无关键字」）
#pragma multi_compile_local __ DEFORM_NORMALS
#pragma multi_compile_local __ DEFORM_MULTIPLE_BUFFERS
#pragma multi_compile_local __ DEFORM_INTRP_SMOOTH DEFORM_INTRP_CUBIC
#pragma multi_compile_local __ DEFORM_ZERO_OUTSIDE
#pragma multi_compile_local __ DEFORM_MASK_CONSTANT DEFORM_MASK_COLOR DEFORM_MASK_UV DEFORM_MASK_TEXTURE
#pragma multi_compile_local __ DEFORM_USE_INDICES

// 只要启用了任意一种遮罩类型，就统一定义 DEFORM_MASK，供后续代码按需分支
#if defined(DEFORM_MASK_CONSTANT) || defined(DEFORM_MASK_COLOR) || defined(DEFORM_MASK_UV) || defined(DEFORM_MASK_TEXTURE)
#define DEFORM_MASK
#endif

// ============================================================================
// 顶点缓冲参数
// ============================================================================
/// <summary>顶点数量。</summary>
uint VertexCount;

/// <summary>主顶点缓冲（可读写，按字节寻址），存放位置/法线/切线等核心属性。</summary>
RWByteAddressBuffer VertexBuffer;
/// <summary>主缓冲中单个顶点的字节步长。</summary>
uint BufferStride;
/// <summary>位置属性在主缓冲内的字节偏移。</summary>
uint PositionOffset;

#ifdef DEFORM_NORMALS
/// <summary>法线属性在主缓冲内的字节偏移。</summary>
uint NormalOffset;
/// <summary>切线属性在主缓冲内的字节偏移。</summary>
uint TangentOffset;
/// <summary>需要同时变形的点数量：位置 + 切线微元点 + 副法线微元点，共 3 个。</summary>
#define NUM_POSITIONS 3
#else
/// <summary>仅变形位置：只需 1 个点。</summary>
#define NUM_POSITIONS 1
#endif

#ifdef DEFORM_MULTIPLE_BUFFERS
/// <summary>附加顶点缓冲（颜色/多组 UV 等次要属性）。</summary>
RWByteAddressBuffer AdditionalBuffer;
/// <summary>附加缓冲中单个顶点的字节步长。</summary>
uint AdditionalStride;
#else
/// <summary>没有附加缓冲时，遮罩读取直接复用主顶点缓冲与主步长。</summary>
#define AdditionalBuffer VertexBuffer
#define AdditionalStride BufferStride
#endif

#ifdef DEFORM_MASK
/// <summary>遮罩数据（顶点色 / UV）在（附加）缓冲内的字节偏移。</summary>
uint MaskOffset;
/// <summary>遮罩采样的通道序号（0=R,1=G,2=B,3=A）。</summary>
uint MaskChannel;
/// <summary>遮罩缩放倍数。</summary>
float MaskMultiplier;
#endif

#ifdef DEFORM_MASK_TEXTURE
/// <summary>用作遮罩的贴图（纹理遮罩时采样）。</summary>
Texture2D<float4> MaskTexture;
/// <summary>贴图遮罩使用的采样器状态。</summary>
SamplerState sampler_MaskTexture;
#endif

#ifdef DEFORM_USE_INDICES
/// <summary>「索引 → 顶点 ID」映射缓冲，实现只变形指定材质（submesh）的顶点。</summary>
StructuredBuffer<int> IndexToVertexMap;
/// <summary>映射缓冲中的有效条目数量。</summary>
uint IndexCount;
#endif

// ============================================================================
// 晶格（deformer）参数
// ============================================================================
/// <summary>晶格控制点偏移缓冲：每个元素是某个控制点相对晶格原位的偏移量（float3）。</summary>
StructuredBuffer<float3> DeformBuffer;
/// <summary>对象空间 → 晶格局部空间 的变换矩阵。</summary>
float4x4 ObjectToDeform;
/// <summary>晶格局部空间 → 对象空间 的变换矩阵（ObjectToDeform 的逆）。</summary>
float4x4 DeformToObject;
/// <summary>晶格三轴分辨率（各轴控制点数量）。</summary>
uint3 DeformResolution;

/// <summary>
/// 获取晶格中指定控制点（handle）的偏移量。
/// <br/>
/// 启用 DEFORM_ZERO_OUTSIDE 时：控制点坐标越界则返回零向量（变形在晶格外衰减为 0）；
/// 随后把坐标钳制到分辨率范围内，从 DeformBuffer 读取对应偏移（Global 模式下越界沿用边缘控制点）。
/// </summary>
/// <param name="handle">控制点在晶格中的整数坐标（可能为负/越界）。</param>
/// <returns>该控制点的偏移量。</returns>
float3 GetOffset(int3 handle)
{
#ifdef DEFORM_ZERO_OUTSIDE
	// 越界归零分支：任一轴越界即视为该控制点偏移为 0
	if (handle.x < 0 || handle.x >= (int)DeformResolution.x || 
		handle.y < 0 || handle.y >= (int)DeformResolution.y ||
		handle.z < 0 || handle.z >= (int)DeformResolution.z)
		return float3(0, 0, 0);
#endif
	
	// 钳制到合法范围（Global 模式：越界控制点沿用最边缘控制点的偏移）
	handle = max(handle, int3(0, 0, 0));
	handle = min(handle, DeformResolution - int3(1, 1, 1));

	// 把三维坐标展平为一维索引（x + 分辨率.x * y + 分辨率.x * 分辨率.y * z）
	int index = handle.x + (DeformResolution.x * handle.y) + (DeformResolution.x * DeformResolution.y * handle.z);
	return DeformBuffer[index];
}

#ifdef DEFORM_INTRP_CUBIC /* 三次方插值分支 */

/// <summary>每轴采样点数：4（共 4×4×4 = 64 个控制点参与插值）。</summary>
#define NUM_SAMPLES 4

/// <summary>
/// 三次插值系数：三个轴各存 4 个权重（Vector4 打包），
/// 综合权重 = x 权重 × y 权重 × z 权重。
/// </summary>
struct Coefficients
{
	float4 x;
	float4 y;
	float4 z;
};

/// <summary>
/// 三次基函数 a₀(t) = 1.5t³ - 2.5t² + 1（过 (0,1) 与 (1,0)）。
/// </summary>
float3 aa0(float3 t)
{
	return 1.5f * t * t * t - 2.5f * t * t + 1.0f;
}

/// <summary>
/// 三次基函数 a₁(t) = -0.5t³ + 2.5t² - 4t + 2（过 (0,2) 与 (1,0)）。
/// </summary>
float3 aa1(float3 t)
{
	return -0.5f * t * t * t + 2.5f * t * t - 4.0f * t + 2.0f; 
}

/// <summary>
/// 根据单元内坐标计算三次插值权重：
/// 用 4 个基函数 h_00/h_10/h_01/h_11（含镜像方向）生成每轴 4 个权重，打包进 Coefficients。
/// </summary>
Coefficients GetCoefficients(float3 cellPosition)
{
	float3 h_00 = aa1(cellPosition + 1);
	float3 h_10 = aa0(cellPosition);
	float3 h_01 = aa0(1 - cellPosition);
	float3 h_11 = aa1(2 - cellPosition);

	Coefficients h;
	h.x = float4(h_00.x, h_10.x, h_01.x, h_11.x);
	h.y = float4(h_00.y, h_10.y, h_01.y, h_11.y);
	h.z = float4(h_00.z, h_10.z, h_01.z, h_11.z);
	return h;
}

#else /* 线性插值分支（默认；启用 DEFORM_INTRP_SMOOTH 时先平滑） */

/// <summary>每轴采样点数：2（共 2×2×2 = 8 个控制点参与插值）。</summary>
#define NUM_SAMPLES 2

/// <summary>
/// 线性插值系数：三个轴各存 2 个权重（Vector2 打包），
/// 综合权重 = x 权重 × y 权重 × z 权重（三线性插值）。
/// </summary>
struct Coefficients
{
	float2 x;
	float2 y;
	float2 z;
};

/// <summary>
/// 根据单元内坐标计算线性插值权重：
/// h_10 = 1 - 坐标（靠近单元起点一侧），h_01 = 坐标（靠近单元终点一侧）。
/// 若启用 DEFORM_INTRP_SMOOTH，先对坐标逐轴做 smoothstep(0,1) 平滑。
/// </summary>
Coefficients GetCoefficients(float3 cellPosition)
{
#ifdef DEFORM_INTRP_SMOOTH
	// 平滑线性：先对单元内坐标做 SmoothStep，使权重过渡更柔和
	cellPosition = smoothstep(0, 1, cellPosition);
#endif
	
	float3 h_10 = 1 - cellPosition;
	float3 h_01 = cellPosition;

	Coefficients h;
	h.x = float2(h_10.x, h_01.x);
	h.y = float2(h_10.y, h_01.y);
	h.z = float2(h_10.z, h_01.z);
	return h;
}

#endif

/// <summary>
/// 计算顶点所在的晶格单元坐标：
/// 晶格局部坐标（范围约 -0.5~0.5）平移 0.5 后缩放至 (Resolution-1)，再向下取整。
/// </summary>
/// <param name="deformPosition">顶点在晶格局部空间的坐标。</param>
/// <returns>所在单元的整数坐标（可能越界，由调用方处理）。</returns>
int3 GetCell(float3 deformPosition)
{
	deformPosition += 0.5f;
	
	// 获取顶点所在的晶格单元
	return int3(
		floor(deformPosition.x * (DeformResolution.x - 1)),
		floor(deformPosition.y * (DeformResolution.y - 1)),
		floor(deformPosition.z * (DeformResolution.z - 1))
	);
}

/// <summary>
/// 计算顶点在其所在单元内的归一化坐标（0~1）：
/// 晶格局部坐标平移 0.5 后缩放至 (Resolution-1)，再减去所在单元的起点坐标。
/// </summary>
/// <param name="deformPosition">顶点在晶格局部空间的坐标。</param>
/// <param name="cell">顶点所在的单元坐标。</param>
/// <returns>单元内归一化坐标（0~1）。</returns>
float3 GetCellPosition(float3 deformPosition, int3 cell)
{
	return (deformPosition + 0.5f) * (DeformResolution - int3(1, 1, 1)) - cell;
}

/// <summary>
/// FFD 核心函数：对一组点（位置 + 可选的切线/副法线微元点）执行变形。
/// <br/>
/// 流程：以第一个点确定单元 → 为每个点缓存插值系数 → 遍历周围 NUM_SAMPLES³ 个控制点，
/// 把「控制点偏移 × 三轴权重乘积」累加到每个点的输出上（输出初始为输入）。
/// </summary>
/// <param name="deformPosition">输入点数组（晶格局部坐标）。</param>
/// <param name="position">输出点数组（变形后的晶格局部坐标）。</param>
void TransformPositions(float3 deformPosition[NUM_POSITIONS], out float3 position[NUM_POSITIONS])
{
	// 以第一个点（位置点）确定所在单元，其余辅助点共用同一单元
	int3 cell = GetCell(deformPosition[0]);
	
	// 为每个输入点缓存插值系数
	Coefficients h[NUM_POSITIONS];
	
	[unroll] 
	for (int r = 0; r < NUM_POSITIONS; r++)
	{
		h[r] = GetCoefficients(GetCellPosition(deformPosition[r], cell));
		position[r] = deformPosition[r];
	}
	
	// 三重循环遍历单元周围的 NUM_SAMPLES³ 个控制点
	[unroll]
	for (int i = 0; i < NUM_SAMPLES; i++)
	{
		[unroll] 
		for (int j = 0; j < NUM_SAMPLES; j++)
		{
			[unroll] 
			for (int k = 0; k < NUM_SAMPLES; k++)
			{
				// 控制点在晶格中的绝对坐标：以 cell 为基准居中偏移（线性：0/1；三次：-1/0/1/2）
				int3 handle = cell + int3(i, j, k) - (NUM_SAMPLES / 2 - 1);
				float3 handleOffset = GetOffset(handle);
				
				// 把该控制点的影响按权重累加到每个输出点上
				[unroll] 
				for (int m = 0; m < NUM_POSITIONS; m++)
				{
					position[m] += handleOffset * (h[m].x[i] * h[m].y[j] * h[m].z[k]);
				}
			}
		}
	}
}

#ifdef DEFORM_MASK
/// <summary>
/// 获取当前顶点的遮罩值（决定顶点被变形的程度，0~1 之间插值）。
/// 基值为 MaskMultiplier；根据遮罩类型再乘以顶点色 / UV 分量 / 贴图采样值。
/// </summary>
/// <param name="id">顶点 ID。</param>
/// <returns>遮罩值。</returns>
float GetMask(uint id)
{
	float mask = MaskMultiplier;
	
#ifdef DEFORM_MASK_COLOR
	// 顶点色遮罩：从（附加）缓冲读取打包的 RGBA32 颜色，解包到 0~1 并取指定通道
	uint rawColor = AdditionalBuffer.Load(id * AdditionalStride + MaskOffset);
	float4 color = 0.00392157f * float4(
		(rawColor >> 0 ) & 0xff,
		(rawColor >> 8 ) & 0xff,
		(rawColor >> 16) & 0xff,
		(rawColor >> 24) & 0xff
	);
	mask *= color[MaskChannel];
#endif
	
#ifdef DEFORM_MASK_UV
	// UV 遮罩：读取两个 float（UV 坐标），取指定分量（x 或 y）作为遮罩值
	float4 color = asfloat(AdditionalBuffer.Load4(id * AdditionalStride + MaskOffset));
	mask *= color[MaskChannel];
#endif

#ifdef DEFORM_MASK_TEXTURE
	// 贴图遮罩：读取 UV 坐标采样贴图，取指定通道作为遮罩值
	float2 uv = asfloat(AdditionalBuffer.Load2(id * AdditionalStride + MaskOffset));
	float4 color = MaskTexture.SampleLevel(sampler_MaskTexture, uv, 0);
	mask *= color[MaskChannel];
#endif
	
	return mask;
}
#endif

/// <summary>
/// Deform 内核：对网格的每个顶点应用晶格变形。
/// <br/>
/// 线程布局：一维线程（X 方向），每线程组 64 个线程；线程 ID 即顶点 ID（或索引映射后的顶点 ID）。
/// 流程：读取原始位置 → 变换到晶格空间 → TransformPositions 变形 → （可选遮罩插值）→ 变换回对象空间 → 写回缓冲；
/// 启用 DEFORM_NORMALS 时，同时用切线/副法线微元点的变形结果重建法线与切线。
/// </summary>
[numthreads(64, 1, 1)]
void Deform(uint id : SV_DispatchThreadID)
{
#ifdef DEFORM_USE_INDICES
	// 按材质索引筛选模式：超出发射范围（索引数量）的线程直接退出；
	// 通过映射表把「索引序号」转换为真正的顶点 ID
	if (id >= IndexCount)
		return;
	
	id = (uint)IndexToVertexMap[id];
#endif
	
	// 超出顶点数量的线程直接退出
	if (id >= VertexCount)
		return;

	float3 input[NUM_POSITIONS];
	float3 output[NUM_POSITIONS];
	
	// 读取原始顶点位置（字节缓冲按 stride + offset 寻址）
	float3 originalPosition = asfloat(VertexBuffer.Load3(id * BufferStride + PositionOffset));
	// 位置点：变换到晶格局部空间（w=1 做齐次变换）
	input[0] = mul(ObjectToDeform, float4(originalPosition, 1)).xyz;
	
#ifdef DEFORM_NORMALS
	// 读取原始法线与切线，并计算副法线（binormal = 法线 × 切线）
	float3 originalNormal   = asfloat(VertexBuffer.Load3(id * BufferStride + NormalOffset));
	float3 originalTangent  = asfloat(VertexBuffer.Load3(id * BufferStride + TangentOffset));
	float3 originalBinormal = cross(originalNormal, originalTangent);

	// 构造两个微元点（原位置沿切线/副法线方向偏移 0.001）：
	// 它们与位置点一起做 FFD，用于在变形后重建新的法线与切线方向
	float3 originalTangentPosition  = originalPosition + 0.001f * originalTangent;
	float3 originalBinormalPosition = originalPosition + 0.001f * originalBinormal;

	input[1] = mul(ObjectToDeform, float4(originalTangentPosition, 1)).xyz;
	input[2] = mul(ObjectToDeform, float4(originalBinormalPosition, 1)).xyz;
#endif
	
	// 执行 FFD 变形（输出仍为晶格局部坐标）
	TransformPositions(input, output);
	
#ifdef DEFORM_MASK
	// 遮罩：在「原始位置」与「完全变形位置」之间按遮罩值插值，控制每个顶点的变形程度
	float mask = GetMask(id);
	
	[unroll] 
	for (int r = 0; r < NUM_POSITIONS; r++)
	{
		output[r] = lerp(input[r], output[r], mask);
	}
#endif
	
	// 把变形后的位置从晶格坐标变换回对象坐标
	float3 position = mul(DeformToObject, float4(output[0], 1)).xyz;
	
	// 写回顶点缓冲中的位置
	VertexBuffer.Store3(id * BufferStride + PositionOffset, asuint(position));
	
#ifdef DEFORM_NORMALS
	// 把变形后的切线/副法线微元点也变换回对象坐标
	float3 tangentPosition  = mul(DeformToObject, float4(output[1], 1)).xyz;
	float3 binormalPosition = mul(DeformToObject, float4(output[2], 1)).xyz;
	
	// 由微元点重建法线与切线：
	// 切线方向 = 变形后的切线微元点 - 变形后的位置；法线方向 = 切线 × (副法线微元点 - 位置)
	float3 tangent = normalize(tangentPosition - position);
	float3 normal  = normalize(cross(tangent, binormalPosition - position));

	// 写回顶点缓冲中的法线与切线
	VertexBuffer.Store3(id * BufferStride + NormalOffset, asuint(normal));
	VertexBuffer.Store3(id * BufferStride + TangentOffset, asuint(tangent));
#endif
	
}
